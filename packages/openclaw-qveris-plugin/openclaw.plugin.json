{
  "id": "qveris",
  "name": "QVeris Plugin",
  "description": "QVeris capability discovery, tool inspection, and tool calling",
  "version": "2026.7.30",
  "setup": {
    "providers": [
      {
        "id": "qveris",
        "authMethods": ["api-key"],
        "envVars": ["QVERIS_API_KEY"]
      }
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["qveris_discover", "qveris_call", "qveris_inspect"]
  },
  "toolMetadata": {
    "qveris_discover": {
      "authSignals": [{ "provider": "qveris" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.qveris.config",
          "required": ["apiKey"]
        }
      ],
      "replaySafe": true
    },
    "qveris_call": {
      "authSignals": [{ "provider": "qveris" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.qveris.config",
          "required": ["apiKey"]
        }
      ],
      "replaySafe": false
    },
    "qveris_inspect": {
      "authSignals": [{ "provider": "qveris" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.qveris.config",
          "required": ["apiKey"]
        }
      ],
      "replaySafe": true
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "QVeris API Key",
      "help": "QVeris API key for capability discovery and tool calling (fallback: QVERIS_API_KEY env var).",
      "sensitive": true,
      "placeholder": "qv-..."
    },
    "baseUrl": {
      "label": "QVeris API Base URL",
      "help": "Optional explicit API endpoint (fallback: QVERIS_BASE_URL, then the public default)."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": { "type": ["string", "object"] },
      "region": {
        "type": "string",
        "deprecated": true,
        "description": "Deprecated and rejected at runtime. Remove this field and set baseUrl or QVERIS_BASE_URL explicitly."
      },
      "baseUrl": { "type": "string" },
      "autoMaterializeFullContent": { "type": "boolean" },
      "fullContentMaxBytes": { "type": "number" },
      "fullContentTimeoutSeconds": { "type": "number" },
      "searchTimeoutSeconds": { "type": "number" },
      "executeTimeoutSeconds": { "type": "number" },
      "maxResponseSize": { "type": "number" },
      "searchLimit": { "type": "number" }
    }
  }
}
